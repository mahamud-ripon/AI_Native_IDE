# Admin Panel Environment Variables

# JWT Secret for admin tokens (generate a secure secret in production)
ADMIN_JWT_SECRET=your-secure-jwt-secret-change-in-production

# API Gateway URL for backend communication
API_GATEWAY_URL=http://localhost:8000

# WebSocket URL for real-time metrics
WS_URL=ws://localhost:8000

# Admin API Key for server-to-server authentication
ADMIN_API_KEY=your-admin-api-key

# Next.js environment
NODE_ENV=development
