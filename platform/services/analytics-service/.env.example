# Analytics Service Environment Variables

# Server
PORT=8010
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_native_ide

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_ENABLED=true
KAFKA_GROUP_ID=analytics-service

# Logging
LOG_LEVEL=info

# Snapshot Worker
SNAPSHOT_RUN_INTERVAL_MS=86400000
