# AI Service Environment Variables

# Server
PORT=8003
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_native_ide

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_ENABLED=true

# AI Provider API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# AI Agents Service (Python backend)
AI_AGENTS_URL=http://localhost:9000
AI_AGENTS_API_KEY=internal-api-key
AI_AGENTS_TIMEOUT=300000

# Circuit Breaker
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=60000
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5

# Logging
LOG_LEVEL=info
