# Server
PORT=8009
NODE_ENV=development

# S3 / MinIO Configuration
# For AWS S3, leave S3_ENDPOINT empty or remove it
# For MinIO, set S3_ENDPOINT to your MinIO URL
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_FORCE_PATH_STYLE=true

# Buckets
S3_BUCKET_USER_FILES=platform-user-files
S3_BUCKET_SNAPSHOTS=platform-snapshots
S3_BUCKET_BUILD_LOGS=platform-build-logs
S3_BUCKET_ARTIFACTS=platform-artifacts
S3_BUCKET_AVATARS=platform-avatars

# Redis (optional - for rate limiting)
REDIS_URL=redis://localhost:6379

# Kafka (optional - for project.deleted events)
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=storage-service
KAFKA_ENABLED=false

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_native_ide

# ClamAV (optional - for virus scanning)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_PUBLIC_KEY=

# Internal API Key (for service-to-service auth)
INTERNAL_API_KEY=internal-api-key-change-in-production

# Storage Limits
MAX_FILE_SIZE=52428800
PRESIGNED_UPLOAD_EXPIRY=900
PRESIGNED_DOWNLOAD_EXPIRY=3600
ORPHAN_CLEANUP_SAFETY_HOURS=24
