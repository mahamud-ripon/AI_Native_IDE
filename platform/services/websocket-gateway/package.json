{
  "name": "@ai-ide/websocket-gateway",
  "version": "1.0.0",
  "description": "WebSocket Gateway for AI-Native IDE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest --run",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@fastify/cookie": "^9.2.0",
    "@fastify/cors": "^8.4.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^7.6.0",
    "@fastify/websocket": "^10.0.1",
    "@workspace/config": "workspace:*",
    "@workspace/database": "workspace:*",
    "@workspace/shared-types": "workspace:*",
    "dotenv": "^16.3.1",
    "fastify": "^4.24.3",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.0",
    "ws": "^8.16.0",
    "yjs": "^13.6.10",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.54.0",
    "ioredis": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2",
    "vitest": "^1.2.0"
  }
