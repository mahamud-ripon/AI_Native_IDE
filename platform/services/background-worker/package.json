{
  "name": "@ai-ide/background-worker",
  "version": "1.0.0",
  "description": "Background job processor for AI-Native IDE platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:connections": "tsx test/test_connections.ts",
    "test:queue": "tsx test/test_queue.ts",
    "test:kafka": "tsx test/test_kafka.ts",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@workspace/config": "workspace:*",
    "@workspace/database": "workspace:*",
    "@workspace/shared-types": "workspace:*",
    "bullmq": "^4.15.0",
    "ioredis": "^5.3.2",
    "node-cron": "^3.0.3",
    "kafkajs": "^2.2.4",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "winston": "^3.11.0",
    "pino": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0"
  }
}
