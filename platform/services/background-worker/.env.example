# Background Worker Environment Configuration

# Node Environment
NODE_ENV=development

# Redis Connection (for queues, caching, distributed locks)
REDIS_URL=redis://localhost:6379

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_ide_db?schema=public"

# Kafka Configuration (for event consumption)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=background-worker
KAFKA_GROUP_ID=background-worker-group

# Downstream Service URLs
EXECUTION_SERVICE_URL=http://localhost:3005
AI_SERVICE_URL=http://localhost:3004
BILLING_SERVICE_URL=http://localhost:3003
EMAIL_SERVICE_URL=http://localhost:3010

# Job Configuration
VM_IDLE_THRESHOLD_MINUTES=10
USAGE_ROLLUP_BATCH_SIZE=100
GARBAGE_COLLECTOR_RETENTION_DAYS=90

# Queue Worker Concurrency
AI_QUEUE_CONCURRENCY=2
EMAIL_QUEUE_CONCURRENCY=10
CLEANUP_QUEUE_CONCURRENCY=5
EMBEDDING_QUEUE_CONCURRENCY=3
USAGE_QUEUE_CONCURRENCY=2

# DLQ (Dead Letter Queue) Configuration
DLQ_MAX_ENTRIES=1000
DLQ_ALERT_THRESHOLD=10

# Monitoring & Alerts
ADMIN_DASHBOARD_URL=http://localhost:3000/admin
SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
