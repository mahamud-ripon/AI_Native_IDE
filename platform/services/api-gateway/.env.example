# API Gateway Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# JWT Public Key (RS256) - Must be loaded from Vault in production
# This is used for stateless JWT verification at the Gateway
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
-----END PUBLIC KEY-----"

# Cookie Secret (for signed cookies)
COOKIE_SECRET=your-super-secret-cookie-key-change-in-production

# Redis Connection
REDIS_URL=redis://localhost:6379

# Downstream Service URLs (for local development)
# In Kubernetes/Docker, these would be internal service DNS names
AUTH_SERVICE_URL=http://localhost:3001
PROJECT_SERVICE_URL=http://localhost:3002
BILLING_SERVICE_URL=http://localhost:3003
AI_SERVICE_URL=http://localhost:3004
EXECUTION_SERVICE_URL=http://localhost:3005
SEARCH_SERVICE_URL=http://localhost:3006
DEPLOYMENT_SERVICE_URL=http://localhost:3007
STORAGE_SERVICE_URL=http://localhost:3008
ANALYTICS_SERVICE_URL=http://localhost:3009
NOTIFICATION_SERVICE_URL=http://localhost:3010

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
AUTHENTICATED_RATE_LIMIT=1000
ANONYMOUS_RATE_LIMIT=50

# Circuit Breaker Configuration
CIRCUIT_BREAKER_TIMEOUT=5000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000
