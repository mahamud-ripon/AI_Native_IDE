# ============================================
# AI-Native IDE Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files with real secrets.
# ============================================

# Node Environment
NODE_ENV=development

# ============================================
# Database (PostgreSQL) - Neon.tech
# ============================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# ============================================
# Redis
# ============================================
REDIS_URL=redis://username:password@host:6379

# ============================================
# Kafka - Redpanda Cloud
# ============================================
KAFKA_BROKERS=your-cluster.cloud.redpanda.com:9092
KAFKA_USERNAME=your-username
KAFKA_PASSWORD=your-password
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_LOG_LEVEL=ERROR

# ============================================
# JWT Authentication (REQUIRED)
# ============================================
JWT_SECRET=generate-a-random-64-char-hex-string
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ============================================
# Cookie Secret (REQUIRED for auth-service)
# ============================================
COOKIE_SECRET=generate-a-random-64-char-hex-string

# ============================================
# Internal API Key (REQUIRED for inter-service auth)
# ============================================
INTERNAL_API_KEY=generate-a-random-string

# ============================================
# Stripe (Billing)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PRO=price_your_pro_price_id
STRIPE_PRICE_TEAM=price_your_team_price_id
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_price_id

# ============================================
# AI Provider Keys
# ============================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ============================================
# Storage - S3 Compatible
# ============================================
S3_ENDPOINT=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================
# Search - Elasticsearch
# ============================================
ELASTICSEARCH_NODE=https://your-cluster.es.cloud:443
ELASTICSEARCH_API_KEY=

# ============================================
# Inter-Service Communication (Local Development)
# ============================================
AUTH_SERVICE_URL=http://localhost:3100
PROJECT_SERVICE_URL=http://localhost:8002
AI_SERVICE_URL=http://localhost:8003
EXECUTION_SERVICE_URL=http://localhost:8004
COLLAB_SERVICE_URL=http://localhost:8005
BILLING_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007
SEARCH_SERVICE_URL=http://localhost:8008
STORAGE_SERVICE_URL=http://localhost:8009
DEPLOYMENT_SERVICE_URL=http://localhost:8010
ANALYTICS_SERVICE_URL=http://localhost:8011
WEBSOCKET_GATEWAY_URL=http://localhost:8012
PYTHON_AGENTS_URL=http://localhost:9000

APP_URL=http://localhost:5173
