  aiTokensUsed       BigInt   @map("ai_tokens_used")
  computeMinutes     Int      @map("compute_minutes")
  storageGb          Decimal  @map("storage_gb") @db.Decimal(10, 3)
  deploymentsCount   Int      @map("deployments_count")
  projectsCount      Int      @map("projects_count")
  collaboratorsCount Int      @map("collaborators_count")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId])
  @@index([periodStart])
  @@map("usage_records")
}

model AuditLog {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
