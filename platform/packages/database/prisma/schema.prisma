// -----------------------------------------------------------------------------
// WORKFLOW CHECKPOINT PERSISTENCE (Phase-2)
// -----------------------------------------------------------------------------

model WorkflowRun {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId             String?            @map("project_id") @db.Uuid
  project               Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Workflow definition
  workflowName          String             @map("workflow_name") @db.VarChar(100)
  workflowVersion       Int                @default(1) @map("workflow_version")
  workflowDefinitionJson Json?             @map("workflow_definition_json")

  // Execution state
  status                WorkflowRunStatus  @default(pending)
  currentStep           Int                @default(0) @map("current_step")
  totalSteps            Int                @default(0) @map("total_steps")
  resumeFromStep        Int?               @map("resume_from_step")

  // Context (agent memory, shared state)
  contextJson           Json?              @map("context_json")

  // Trigger info
  triggeredBy           String?            @map("triggered_by") @db.Uuid
  triggerType           String             @default("manual") @map("trigger_type") @db.VarChar(50)
  parentRunId           String?            @map("parent_run_id") @db.Uuid

  // Timing
  startedAt             DateTime?          @map("started_at") @db.Timestamptz()
  completedAt           DateTime?          @map("completed_at") @db.Timestamptz()
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  // Metrics
  totalTokensIn         Int                @default(0) @map("total_tokens_in")
  totalTokensOut        Int                @default(0) @map("total_tokens_out")
  totalCostUsd          Decimal?           @map("total_cost_usd") @db.Decimal(10, 6)

  // Error tracking
  errorMessage          String?            @map("error_message") @db.Text
  errorStep             Int?               @map("error_step")

  // Relations
  steps                 StepRun[]
  checkpoints           Checkpoint[]

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@map("workflow_runs")
}

model StepRun {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowRunId         String         @map("workflow_run_id") @db.Uuid
  workflowRun           WorkflowRun    @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  // Step definition
  stepIndex             Int            @map("step_index")
  stepName              String         @map("step_name") @db.VarChar(100)
  agentName             String         @map("agent_name") @db.VarChar(50)

  // Execution state
  status                StepRunStatus  @default(pending)
  attemptNumber         Int            @default(1) @map("attempt_number")
  retryCount            Int            @default(0) @map("retry_count")
  maxRetries            Int            @default(3) @map("max_retries")

  // Input/Output (small data only - large outputs go to object storage)
  inputJson             Json?          @map("input_json")
  outputJson            Json?          @map("output_json")
  outputS3Key           String?        @map("output_s3_key") @db.Text

  // Timing
  startedAt             DateTime?      @map("started_at") @db.Timestamptz()
  completedAt           DateTime?      @map("completed_at") @db.Timestamptz()
  durationMs            Int?           @map("duration_ms")

  // LLM metrics
  tokensIn              Int            @default(0) @map("tokens_in")
  tokensOut             Int            @default(0) @map("tokens_out")
  costUsd               Decimal?       @map("cost_usd") @db.Decimal(10, 6)
  provider              String?        @db.VarChar(50)
  model                 String?        @db.VarChar(100)

  // Tracing
  requestId             String?        @map("request_id") @db.VarChar(100)

  // Error handling
  errorMessage          String?        @map("error_message") @db.Text
  errorStack            String?        @map("error_stack") @db.Text

  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([workflowRunId, stepIndex])
  @@index([workflowRunId])
  @@index([status])
  @@index([agentName])
  @@index([requestId])
  @@map("step_runs")
}

model Checkpoint {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowRunId         String          @map("workflow_run_id") @db.Uuid
  workflowRun           WorkflowRun     @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  // Checkpoint metadata
  type                  CheckpointType  @default(post_step)
  stepIndex             Int             @map("step_index")
  stepName              String          @map("step_name") @db.VarChar(100)

  // State snapshot (max 256KB - larger goes to S3)
  stateJson             Json            @map("state_json")
  stateS3Key            String?         @map("state_s3_key") @db.Text

  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  @@index([workflowRunId])
  @@index([workflowRunId, stepIndex])
  @@index([workflowRunId, createdAt])
  @@map("checkpoints")
}

// -----------------------------------------------------------------------------
// EXECUTION CONTROL PLANE (Phase-6A)
// -----------------------------------------------------------------------------

enum ExecutionTaskStatus {
  pending
  queued
  running
  completed
  failed
  cancelled
  timeout
}

enum ExecutionTaskPriority {
  low
  normal
  high
  urgent
}

enum ExecutionEventType {
  task_created
  task_queued
  task_started
  plan_generated
  patch_generated
  validation_started
  validation_completed
  patch_applied
  task_completed
  task_failed
  task_cancelled
  progress_update
}

model ExecutionTask {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String                @map("project_id") @db.Uuid
  workspaceId     String                @map("workspace_id") @db.VarChar(255)
  conversationId  String?               @map("conversation_id") @db.Uuid
  
  // Task definition
  instruction     String                @db.Text
  branch          String?               @db.VarChar(100)
  priority        ExecutionTaskPriority @default(normal)
  
  // Execution state
  status          ExecutionTaskStatus   @default(pending)
  progress        Int                   @default(0)  // 0 - 100
  currentStage    String?               @map("current_stage") @db.VarChar(50)
  stageMessage    String?               @map("stage_message") @db.Text
  
  // Retry support
  retryCount      Int                   @default(0) @map("retry_count")
  maxRetries      Int                   @default(2) @map("max_retries")
  
  // Worker ownership
  workerId        String?               @map("worker_id") @db.VarChar(100)
  
  // Configuration
  options         Json?                 @map("options")
  timeoutMs       Int                   @default(120000) @map("timeout_ms")
  enableRollback  Boolean               @default(true) @map("enable_rollback")
  enableSandbox   Boolean               @default(true) @map("enable_sandbox")
  dryRun          Boolean               @default(false) @map("dry_run")
  
  // Result data (split for performance)
  summary         Json?                 @map("summary")        // Execution metadata
  artifacts       Json?                 @map("artifacts")      // Patches, logs, outputs
  error           Json?                 @map("error")
  patchesApplied  Int                   @default(0) @map("patches_applied")
  filesModified   Int                   @default(0) @map("files_modified")
  
  // Metrics
  totalDurationMs Int?                  @map("total_duration_ms")
  planningMs      Int?                  @map("planning_ms")
  executionMs     Int?                  @map("execution_ms")
  validationMs    Int?                  @map("validation_ms")
  tokensUsed      Int                   @default(0) @map("tokens_used")
  costUsd         Decimal?              @map("cost_usd") @db.Decimal(10, 6)
  
  // Ownership
  createdBy       String                @map("created_by") @db.Uuid
  agentName       String?               @map("agent_name") @db.VarChar(50)
  workflowRunId   String?               @map("workflow_run_id") @db.Uuid
  
  // Timestamps
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  queuedAt        DateTime?             @map("queued_at") @db.Timestamptz()
  startedAt       DateTime?             @map("started_at") @db.Timestamptz()
  completedAt     DateTime?             @map("completed_at") @db.Timestamptz()
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz()
  
  // Snapshot for rollback
  snapshotId      String?               @map("snapshot_id") @db.VarChar(100)
  rollbackPerformed Boolean             @default(false) @map("rollback_performed")

  @@index([projectId])
  @@index([workspaceId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@index([projectId, status])
  @@index([status, priority])
  @@index([workerId])
  @@map("execution_tasks")
}

model ExecutionTaskEvent {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId          String              @map("task_id") @db.Uuid
  
  // Ordering guarantee
  sequence        Int
  
  // Event data
  eventType       ExecutionEventType  @map("event_type")
  stage           String              @db.VarChar(50)
  message         String              @db.Text
  progress        Int                 // 0 - 100
  
  // Optional payload
  payload         Json?               @map("payload")
  
  // Timestamp
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  @@index([taskId])
  @@index([taskId, sequence])
  @@index([eventType])
  @@map("execution_task_events")
}
