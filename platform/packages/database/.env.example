# ============================================
# Database Environment Configuration
# ============================================

# Local Development (Docker)
DATABASE_URL=postgresql://ainative:ainative_pass@localhost:5432/ainative_ide?schema=public

# For Prisma Migrate (Docker)
POSTGRES_USER=ainative
POSTGRES_PASSWORD=ainative_pass
POSTGRES_DB=ainative_ide

# --------------------------------------------
# Neon.tech (Production / Cloud Development)
# --------------------------------------------
# Get your connection string from: https://console.neon.tech
# 
# Direct Connection (for migrations, admin tasks)
# DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/[database]?sslmode=require
#
# Pooled Connection (recommended for serverless/Prisma)
# DATABASE_URL=postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/[database]?sslmode=require&pgbouncer=true
#
# Important Notes:
# - Neon requires SSL: always include sslmode=require
# - For Prisma with connection pooling: add &pgbouncer=true
# - Pooled connections use port 5432 (same as direct)
# - Neon supports pgvector extension (no schema changes needed)
#
# Example:
# DATABASE_URL=postgresql://ainative_owner:abc123@ep-cool-darkness-123456.us-east-2.aws.neon.tech/ainative_ide?sslmode=require
