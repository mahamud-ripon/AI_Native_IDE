# ============================================
# AI-Native IDE Docker Environment Configuration
# ============================================

NODE_ENV=development

# ============================================
# Infrastructure
# ============================================
POSTGRES_USER=ainative
POSTGRES_PASSWORD=ainative_pass
POSTGRES_DB=ainative_ide
# Use 'postgres' as the hostname inside Docker network
DATABASE_URL=postgresql://ainative:ainative_pass@postgres:5432/ainative_ide?schema=public

REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:29092
KAFKA_LOG_LEVEL=ERROR
ELASTICSEARCH_NODE=http://elasticsearch:9200
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ainative-ide
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminpassword

# ============================================
# Services URL
# ============================================
API_GATEWAY_URL=http://api-gateway:8000
WS_GATEWAY_URL=ws://websocket-gateway:8012
PYTHON_AGENTS_URL=http://ai-native-python-agents:9000

# ============================================
# Secrets
# ============================================
JWT_SECRET=bbd10660acae40706579aeafa9df3a0c8205da1eb96e8882a1a406db83a865b7
INTERNAL_API_KEY=dev-internal-key
JWT_PRIVATE_KEY=development-private-key
JWT_PUBLIC_KEY=development-public-key

